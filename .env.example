# TEMPLE SEVA BOOKING SYSTEM - ENVIRONMENT CONFIGURATION

# Node Environment
NODE_ENV=development

# Server Port and Host
PORT=4000
HOST=0.0.0.0

# Database Configuration:
# - Leave empty to use embedded real PostgreSQL WASM database (zero installation required, stored in ./temple_data.db)
# - Or provide your Supabase / AWS RDS / local PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require
DATABASE_URL=

# JWT Secret for Staff & Poojari Sessions
JWT_SECRET=sringeri-temple-sacred-key-dev-environment-v1-production-ready

# Initial Seed Credentials (Used only on initial setup/seed)
INITIAL_ADMIN_PASSWORD=Admin@Sringeri123
INITIAL_STAFF_PASSWORD=Staff@Sringeri123
INITIAL_POOJARI_PASSWORD=Poojari@Sringeri123

